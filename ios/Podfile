platform :ios, '13.0'

# 1. Robust logic to find the Flutter Root (Works for FlutLab & GitHub Actions)
def flutter_root
  # First, try to get it from the environment variable (GitHub Actions sets this)
  env_root = ENV['FLUTTER_ROOT']
  return env_root if env_root && File.exist?(env_root)

  # Second, try to find it via the Generated config file
  # Note: The path is 'Flutter/Generated.xcconfig' relative to the Podfile
  generated_xcode_build_settings_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  if File.exist?(generated_xcode_build_settings_path)
    File.foreach(generated_xcode_build_settings_path) do |line|
      matches = line.match(/FLUTTER_ROOT\=(.*)/)
      return matches[1].strip if matches
    end
  end

  # Fallback error
  raise "Flutter Root not found. Run 'flutter pub get' in the project root first."
end

# 2. Load the Flutter Pod helper logic
require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # Enable Bluetooth/Media Permissions
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_BLUETOOTH=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1'
      ]
      
      # Force iOS 13.0 target for all plugins
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
