<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- 1. Identity & Naming -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>BT SecureChat</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>bt_secure_chat</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- 2. Bluetooth Hardware Permissions (iOS 13+) -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>This app uses Bluetooth to discover nearby users and establish an encrypted peer-to-peer chat session without requiring internet access.</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>This app acts as a peripheral to allow other secure nodes to find and link with your device for offline messaging.</string>

    <!-- 3. Location Permissions (Required for Bluetooth Scanning & Wifi SSID) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Location access is required to perform Bluetooth LE scans and identify local network segments for peer discovery.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Background location enables the app to maintain the secure radio link and notify you of new messages even when the app is minimized.</string>

    <!-- 4. Local Network (iOS 14+ Required for WifiService) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>This app uses the local network to discover and connect with other chat partners on the same Wi-Fi or Hotspot network.</string>
    <key>NSBonjourServices</key>
    <array>
        <string>_http._tcp</string>
        <string>_bonjour._tcp</string>
        <string>_lnp._tcp.</string>
    </array>

    <!-- 5. Media & File Sharing Permissions -->
    <key>NSCameraUsageDescription</key>
    <string>The camera is used to take photos that are then encrypted and sent securely to your chat partner.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>The microphone is used to record secure voice messages for transmission through the encrypted tunnel.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Access to your gallery is required to select and encrypt images for sharing within the secure chat.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>This allows the app to save decrypted photos received from your chat partner directly to your gallery.</string>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>

    <!-- 6. Security & Encryption Compliance -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
    </dict>

    <!-- 7. Background Operational Modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>bluetooth-central</string>
        <string>bluetooth-peripheral</string>
        <string>fetch</string>
        <string>remote-notification</string>
    </array>

    <!-- 8. UI Appearance & Performance -->
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
    <key>UIStatusBarStyle</key>
    <string>UIStatusBarStyleLightContent</string>
    <key>UIViewControllerBasedStatusBarAppearance</key>
    <false/>
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>
    <key>FLTEnableImpeller</key>
    <true/>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- 9. Navigation & System Integration -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>itms-apps</string>
        <string>mailto</string>
        <string>tel</string>
    </array>

    <!-- 10. Device Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- 11. Input & Logic Metadata -->
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
</dict>
</plist>